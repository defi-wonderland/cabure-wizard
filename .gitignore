node_modules/
dist/
*.tsbuildinfo
.env
.env.*
coverage/

# Keep template fixtures visible for create-cabure-ceremony
!packages/create-cabure-ceremony/templates/
!packages/create-cabure-ceremony/templates/**

# ...but the negation above also re-includes build artifacts a developer creates by
# running install/build inside the template app. Re-ignore those (last match wins).
packages/create-cabure-ceremony/templates/node_modules/
packages/create-cabure-ceremony/templates/.next/
packages/create-cabure-ceremony/templates/*.tsbuildinfo
packages/create-cabure-ceremony/templates/package-lock.json
packages/create-cabure-ceremony/templates/next-env.d.ts
.vercel
